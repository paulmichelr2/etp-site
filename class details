<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>English To Perfection – Детальная информация</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Roboto, system-ui, sans-serif; }
    body { background: #f0f4f9; padding: 2rem 1rem; display: flex; justify-content: center; }
    .container { max-width: 1200px; width: 100%; background: white; border-radius: 32px; padding: 2.5rem 2.5rem; box-shadow: 0 20px 60px rgba(0,0,0,0.08); }

    .logo { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.2rem; }
    .logo-icon { font-size: 2.4rem; background: #0b2b4a; color: #f5b042; width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.8rem; }
    .logo-text { font-size: 2.6rem; font-weight: 700; color: #0b2b4a; letter-spacing: -0.5px; }
    .logo-text span { color: #f5b042; }
    .subhead { font-size: 1.1rem; color: #3a5a7a; margin: 0.3rem 0 1.8rem 0; border-left: 5px solid #f5b042; padding-left: 1rem; }
    .badge { background: #eef6ff; color: #0b2b4a; padding: 0.3rem 1.2rem; border-radius: 40px; font-weight: 600; font-size: 0.85rem; display: inline-block; margin-bottom: 0.5rem; }

    h2 { font-size: 2rem; color: #0b2b4a; margin: 2.5rem 0 1rem 0; border-bottom: 3px solid #f5b042; padding-bottom: 0.5rem; }
    h3 { font-size: 1.4rem; color: #0b2b4a; margin: 1.8rem 0 0.8rem 0; }
    h4 { font-size: 1.1rem; color: #1a3a5a; margin: 1.2rem 0 0.4rem 0; }

    .detail-card { background: #f9fbfd; border-radius: 16px; padding: 1.5rem; margin: 1rem 0; border-left: 4px solid #f5b042; }
    .detail-card p { line-height: 1.7; color: #2a3a5a; }
    .detail-card ul { list-style: none; padding: 0.5rem 0 0 1rem; }
    .detail-card li { padding: 0.5rem 0; border-bottom: 1px solid #e9edf2; display: flex; gap: 0.8rem; align-items: flex-start; }
    .detail-card li:last-child { border-bottom: none; }
    .detail-card .emoji { font-size: 1.2rem; min-width: 28px; }

    .highlight-box { background: #eef6ff; border-radius: 12px; padding: 1.2rem; margin: 0.8rem 0; border: 1px solid #d0d7e2; }
    .highlight-box strong { color: #0b2b4a; }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin: 1rem 0; }

    .table-wrap { overflow-x: auto; margin: 1.5rem 0; border-radius: 18px; border: 1px solid #e2e8f0; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 900px; }
    th { background: #0b2b4a; color: white; padding: 0.9rem 0.6rem; text-align: left; font-weight: 600; white-space: nowrap; }
    td { padding: 0.7rem 0.6rem; border-bottom: 1px solid #edf2f7; }
    tr:hover { background: #f8fafc; }
    .table-caption { text-align: center; font-weight: 700; font-size: 1.2rem; padding: 12px 0; color: var(--primary); }

    .faq-item { background: white; border-radius: 12px; padding: 1.2rem 1.5rem; margin: 0.8rem 0; border: 1px solid #e2e8f0; }
    .faq-item h4 { margin-top: 0; color: #0b2b4a; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
    .faq-item h4 .arrow { transition: 0.3s; }
    .faq-item .answer { max-height: 0; overflow: hidden; transition: 0.4s ease; }
    .faq-item .answer.show { max-height: 500px; padding-top: 0.8rem; }
    .faq-item .answer p { line-height: 1.7; color: #2a3a5a; }
    .faq-item .answer ul { list-style: none; padding: 0.3rem 0 0 1rem; }
    .faq-item .answer ul li { padding: 0.2rem 0; border: none; }

    .contact-block { background: #0b2b4a; color: white; border-radius: 16px; padding: 1.5rem; margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 2rem; justify-content: center; }
    .contact-block a { color: #f5b042; text-decoration: none; font-weight: 500; }
    .contact-block a:hover { text-decoration: underline; }

    .vk-block {
      background: linear-gradient(135deg, #4a76a8, #2a5a8a);
      border-radius: 16px;
      padding: 1.8rem 2rem;
      margin: 2rem 0 1.5rem 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.5rem;
      box-shadow: 0 8px 25px rgba(74, 118, 168, 0.3);
    }
    .vk-block .vk-text {
      color: white;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .vk-block .vk-text .vk-icon {
      font-size: 2.8rem;
      line-height: 1;
    }
    .vk-block .vk-text h3 {
      color: white;
      margin: 0;
      font-size: 1.4rem;
    }
    .vk-block .vk-text p {
      color: rgba(255,255,255,0.85);
      margin: 0.2rem 0 0 0;
      font-size: 0.95rem;
    }
    .vk-block .vk-btn {
      background: white;
      color: #2a5a8a;
      padding: 0.8rem 2.2rem;
      border-radius: 60px;
      font-weight: 700;
      font-size: 1.1rem;
      text-decoration: none;
      transition: 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
      white-space: nowrap;
    }
    .vk-block .vk-btn:hover {
      transform: scale(1.04);
      box-shadow: 0 6px 25px rgba(0,0,0,0.25);
      background: #f5f5f5;
    }

    .max-block {
      background: linear-gradient(135deg, #2d2d2d, #1a1a1a);
      border-radius: 16px;
      padding: 1.8rem 2rem;
      margin: 1.5rem 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.5rem;
      box-shadow: 0 8px 25px rgba(0,0,0,0.25);
    }
    .max-block .max-text {
      color: white;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .max-block .max-text .max-icon {
      font-size: 2.8rem;
      line-height: 1;
    }
    .max-block .max-text h3 {
      color: white;
      margin: 0;
      font-size: 1.4rem;
    }
    .max-block .max-text p {
      color: rgba(255,255,255,0.8);
      margin: 0.2rem 0 0 0;
      font-size: 0.95rem;
    }
    .max-block .max-btn {
      background: #f5b042;
      color: #1a1a1a;
      padding: 0.8rem 2.2rem;
      border-radius: 60px;
      font-weight: 700;
      font-size: 1.1rem;
      text-decoration: none;
      transition: 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      box-shadow: 0 4px 15px rgba(0,0,0,0.2);
      white-space: nowrap;
    }
    .max-block .max-btn:hover {
      transform: scale(1.04);
      box-shadow: 0 6px 25px rgba(0,0,0,0.3);
      background: #e6a03a;
    }

    .vk-widget {
      background: #f9fbfd;
      border-radius: 16px;
      padding: 1.5rem;
      margin: 1rem 0;
      border: 2px solid #4a76a8;
      text-align: center;
    }
    .vk-widget iframe {
      max-width: 100%;
      border: none;
      border-radius: 12px;
    }

    .share-section {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
      margin: 1.5rem 0;
    }
    .share-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.7rem 1.5rem;
      border-radius: 60px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.3s;
      color: white;
      border: none;
      cursor: pointer;
      font-size: 0.95rem;
    }
    .share-btn:hover { transform: scale(1.05); opacity: 0.9; }
    .share-vk { background: #4a76a8; }
    .share-telegram { background: #0088cc; }
    .share-whatsapp { background: #25d366; }
    .share-email { background: #6a7e96; }

    .btn-back { background: #f5b042; color: #0b2b4a; padding: 0.8rem 2rem; border-radius: 60px; font-weight: 700; text-decoration: none; display: inline-block; margin-top: 1.5rem; }
    .btn-back:hover { background: #e6a03a; transform: scale(1.02); }

    .thankyou-page {
      display: none;
      text-align: center;
      padding: 3rem 1rem;
      animation: fadeIn 0.6s ease;
    }
    .thankyou-page.show { display: block; }
    .thankyou-page .big-icon { font-size: 4rem; }
    .thankyou-page h2 { border-bottom: none; color: #0b2b4a; font-size: 2.4rem; }
    .thankyou-page p { font-size: 1.2rem; color: #3a5a7a; max-width: 600px; margin: 1rem auto; }

    .teacher-cancel-box {
      background: #fef9e7;
      border-left: 6px solid #f5b042;
      border-radius: 16px;
      padding: 1.5rem 2rem;
      margin: 1.2rem 0;
    }
    .teacher-cancel-box .emoji-big { font-size: 2rem; margin-right: 0.5rem; }
    .teacher-cancel-box strong { color: #0b2b4a; }

    .group-info-box {
      background: #e8f4f8;
      border-left: 6px solid #2a7a8a;
      border-radius: 16px;
      padding: 1.5rem 2rem;
      margin: 1.2rem 0;
    }
    .group-info-box .emoji-big { font-size: 2rem; margin-right: 0.5rem; }
    .group-info-box strong { color: #0b2b4a; }

    .exam-box {
      background: #f0f4e8;
      border-left: 6px solid #5a8a3a;
      border-radius: 16px;
      padding: 1.5rem 2rem;
      margin: 1.2rem 0;
    }
    .exam-box .emoji-big { font-size: 2rem; margin-right: 0.5rem; }
    .exam-box strong { color: #0b2b4a; }

    .bonus-box {
      background: #fef0e8;
      border-left: 6px solid #e87a3a;
      border-radius: 16px;
      padding: 1.5rem 2rem;
      margin: 1.2rem 0;
    }
    .bonus-box .emoji-big { font-size: 2rem; margin-right: 0.5rem; }
    .bonus-box strong { color: #0b2b4a; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 700px) {
      .logo-text { font-size: 1.8rem; }
      .logo-icon { width: 48px; height: 48px; font-size: 1.4rem; }
      .grid-2 { grid-template-columns: 1fr; }
      .container { padding: 1.2rem 1rem; }
      h2 { font-size: 1.5rem; }
      .vk-block, .max-block { flex-direction: column; text-align: center; padding: 1.5rem; }
      .vk-block .vk-text, .max-block .max-text { flex-direction: column; text-align: center; }
      .vk-block .vk-btn, .max-block .max-btn { white-space: normal; }
      .share-section { flex-direction: column; align-items: center; }
      .share-btn { width: 100%; justify-content: center; }
      .teacher-cancel-box, .group-info-box, .exam-box, .bonus-box { padding: 1rem; }
      th, td { padding: 0.4rem 0.3rem; font-size: 0.75rem; }
    }
  </style>
</head>
